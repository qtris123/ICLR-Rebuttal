+def _rotate_vectors_rope(model, x: torch.Tensor, from_pos, to_pos) -> torch.Tensor:
+    """RoPE-rotate rows of ``x`` (L, d) from ``from_pos`` to ``to_pos``."""
+    if x.shape[0] == 0:
+        return x
+    if isinstance(from_pos, int) and isinstance(to_pos, int):
+        if from_pos == to_pos:
+            return x
+        cur = torch.tensor([from_pos], device=x.device, dtype=torch.long)
+        tgt = torch.tensor([to_pos], device=x.device, dtype=torch.long)
+        changed_mask = None
+    else:
+        cur = torch.as_tensor(from_pos, device=x.device, dtype=torch.long)
+        tgt = torch.as_tensor(to_pos, device=x.device, dtype=torch.long)
+        changed_mask = cur != tgt
+        if not changed_mask.any():
+            return x
+
+    from ..compaction_methods.chunked import compute_rope_correction
+    cos_diff, sin_diff = compute_rope_correction(
+        model, cur, tgt, device=x.device, dtype=torch.float32
+    )
+    x32 = x.to(torch.float32)
+    half = x32.shape[-1] // 2
+    rot_x = torch.cat((-x32[..., half:], x32[..., :half]), dim=-1)
+    rotated = (x32 * cos_diff[0] + rot_x * sin_diff[0]).to(x.dtype)
+    if changed_mask is not None and not changed_mask.all():
+        return torch.where(changed_mask.unsqueeze(-1), rotated, x)
+    return rotated
+
+
+def _slice_attention_bias(
+    attention_bias: torch.Tensor, n_q: int, q_start: int, q_end: int, k_limit: int = None
+) -> torch.Tensor:
+    """Slice optional attention bias along query and key dims when present."""
+    if attention_bias is None:
+        return None
+    b = attention_bias
+    if b.dim() >= 2 and b.shape[0] == n_q:
+        b = b[q_start:q_end]
+    if k_limit is not None:
+        b = b[..., :k_limit]
+    return b
+
+
+def _compute_teacher_attention_output(
+    K: torch.Tensor, V: torch.Tensor, queries: torch.Tensor, attention_bias: torch.Tensor = None
+) -> torch.Tensor:
+    """Blocked float32 softmax(Q K^T / sqrt(d) + bias) @ V over teacher KV."""
+    n_q, d = queries.shape
+    if n_q == 0:
+        return torch.empty(0, V.shape[1], dtype=torch.float32, device=K.device)
+    inv_sqrt_d = d ** -0.5
+    V32 = V.to(torch.float32)
+    T_k = K.shape[0]
+    blk = n_q if n_q * T_k <= 64_000_000 else max(1, 64_000_000 // T_k)
+    Y = torch.empty(n_q, V.shape[1], dtype=torch.float32, device=K.device)
+    for s0 in range(0, n_q, blk):
+        sK32 = (queries[s0:s0 + blk] @ K.T).to(torch.float32) * inv_sqrt_d
+        if attention_bias is not None:
+            b32 = attention_bias.to(torch.float32)
+            if b32.dim() >= 2 and b32.shape[0] == n_q:
+                b32 = b32[s0:s0 + blk]
+            sK32 = sK32 + torch.broadcast_to(b32, sK32.shape)
+        Y[s0:s0 + blk] = torch.softmax(sK32, dim=1) @ V32
+        del sK32
+    return Y
+
