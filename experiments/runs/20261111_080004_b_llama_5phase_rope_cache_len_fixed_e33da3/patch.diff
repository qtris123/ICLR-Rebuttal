+        def _accum_teacher(K_ref, q_slice, q_off, b_slice):
+            nq_s = q_slice.shape[0]
+            if nq_s == 0:
+                return
+            Tk = K_ref.shape[0]
+            blk = nq_s if nq_s * Tk <= 64_000_000 else max(1, 64_000_000 // Tk)
+            for s0 in range(0, nq_s, blk):
+                s1 = min(s0 + blk, nq_s)
+                sc = (q_slice[s0:s1] @ K_ref.T).to(torch.float32) * inv_sqrt_d
+                if b_slice is not None:
