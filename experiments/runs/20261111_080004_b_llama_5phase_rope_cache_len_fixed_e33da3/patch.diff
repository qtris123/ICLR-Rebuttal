+    def _student_nnls_beta(
+        self, K, queries_t, C1_s, queries_s, idx, n_doc_q, n_memory, attention_bias
+    ) -> torch.Tensor:
+        """Fit student beta via NNLS in the student RoPE frame matching teacher mass."""
+        n_q, d = queries_t.shape
