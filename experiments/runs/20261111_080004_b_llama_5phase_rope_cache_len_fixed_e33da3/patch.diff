+class _TinyRotaryEmb(torch.nn.Module):
+    """Minimal HF-compatible RoPE module for CPU RoPE-alignment tests."""
+
+    def __init__(self, head_dim: int = 8, theta: float = 10000.0):
+        super().__init__()
+        inv_freq = 1.0 / (theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32) / head_dim))
+        self.register_buffer("inv_freq", inv_freq, persistent=False)
+        self.attention_scaling = 1.0
+
+    def forward(self, x: torch.Tensor, position_ids: torch.Tensor):
+        freqs = position_ids.to(torch.float32).unsqueeze(-1) * self.inv_freq
+        emb = torch.cat([freqs, freqs], dim=-1)
+        return emb.cos().to(x.dtype), emb.sin().to(x.dtype)
+
+
+def _apply_rope_single(model, x: torch.Tensor, positions: torch.Tensor) -> torch.Tensor:
+    """Apply HF rotary_emb at exact `positions` onto pre-RoPE vectors `x`."""
+    cos, sin = model.model.rotary_emb(x, positions.unsqueeze(0))
+    half = x.shape[-1] // 2
+    rot = torch.cat((-x[..., half:], x[..., :half]), dim=-1)
+    return x * cos[0] + rot * sin[0]
+
+
