+    q_u_eval = torch.cat([qd_eval, qm_eval], dim=0)
+    C1_ord = torch.cat([C1_us[frozen], C1_us[open_slots]], dim=0)
+    C2_ord_expected = alg_u._compute_C2_frozen_from_targets(
+        C1_ord, torch.zeros(8), vm[frozen], V_u[written], q_u_eval, torch.cat([Y_doc_ref, Y_mem_ref], dim=0),
+    )
+    assert torch.allclose(C2_us[open_slots], C2_ord_expected[len(frozen):], rtol=1e-4, atol=1e-4)
+    # Using leaked [M || Doc] target for mem_q would diverge significantly from C2_us.
+    Y_mem_leaked = torch.softmax((qm_t @ K_u.T) * (d ** -0.5), dim=-1) @ V_u
+    C2_leaked = alg_u._compute_C2_frozen_from_targets(
+        C1_ord, torch.zeros(8), vm[frozen], V_u[written], q_u_eval, torch.cat([Y_doc_ref, Y_mem_leaked], dim=0),
+    )
+    assert (C2_us[open_slots] - C2_leaked[len(frozen):]).abs().max().item() > 1.0
+
