+def test_per_layer_on_policy_dual_teacher_prefix(monkeypatch):
+    """Layer 1 on-policy extraction receives Layer 0's teacher keys while output holds rebased keys."""
+    from submem.compaction.compaction_methods.per_layer_head_on_policy import (
+        PerLayerHeadOnPolicyCompaction,
+    )
+    from submem.compaction.query_generation import QueryConfig
+    from submem.compaction.query_generation.config import (
+        SelfStudyConfig, QueryMethodConfig, ConversationSpec,
+    )
+
+    torch.manual_seed(1)
+    d = 8
+    rot = _TinyRotaryEmb(head_dim=d)
+    cfg = types.SimpleNamespace(
+        num_hidden_layers=2, num_attention_heads=1, num_key_value_heads=1,
+        head_dim=d, sliding_window=None, _name_or_path="meta-llama/Llama-3.2-3B-Instruct",
+    )
+    model = types.SimpleNamespace(config=cfg, model=types.SimpleNamespace(rotary_emb=rot))
+
+    raw_k = torch.randn(2, 1, 12, d)
+    pos_k = torch.arange(50, 62)
+    kv = tuple(
+        (_apply_rope_single(model, raw_k[li, 0], pos_k).unsqueeze(0).unsqueeze(0), torch.randn(1, 1, 12, d))
+        for li in range(2)
+    )
+    raw_q = torch.randn(2, 1, 6, d)
+    q_t = torch.stack([
+        _apply_rope_single(model, raw_q[li, 0], 100 + torch.arange(6)).unsqueeze(0)
+        for li in range(2)
+    ], dim=0)
+
+    seen_prefix = []
+    method = PerLayerHeadOnPolicyCompaction(
+        algorithm_class=HighestAttentionKeysCompaction,
+        algorithm_kwargs={"beta_method": "zero", "c2_method": "lsq", "c2_ridge_lambda": 1e-4, "c2_solver": "cholesky"},
+    )
+    method.rope_align_spec = {
+        "model": model, "key_pos_base": 50, "dst_pos_base": 0,
+        "teacher_query_pos": 100, "student_query_pos": 4,
+        "n_memory": 0, "teacher_mem_query_pos": 0, "inplace_frozen": False,
+    }
+
+    monkeypatch.setattr(
+        method, "_generate_queries_with_sequences",
+        lambda **kw: (
+            q_t,
+            {
+                "final_n_queries_per_kv_head": 6,
+                "methods_used": {"self_study": {"query_range": (0, 6), "stats": {}}},
+            },
+            [{"suffix_token_ids": torch.zeros(1, 1, dtype=torch.long)}],
+        ),
+    )
+
+    def fake_extract(self_or_kw=None, **kw):
+        seen_prefix.append(kw["compacted_cache_prefix"])
+        return q_t[kw["layer_idx"]]
+
+    monkeypatch.setattr(method, "_extract_on_policy_queries_for_layer", fake_extract)
+
+    q_cfg = QueryConfig(
+        method_configs=[
+            QueryMethodConfig(
+                method="self_study",
+                fraction=1.0,
+                config=SelfStudyConfig(
+                    conversation_specs=[
+                        ConversationSpec(conversation_starter="q", prefill_with_article=True)
+                    ]
+                ),
+            )
+        ]
+    )
+    out, _ = method.compact_kv_cache(
+        past_key_values=kv, target_size=4, indices=range(0, 12),
+        query_config=q_cfg, model=model, tokenizer=None, formatted_context="",
+    )
+    assert len(seen_prefix) == 1
+    # Teacher prefix seen by layer 1 differs from rebased student layer 0 keys (moved 50..61 -> 0..3).
+    prefix_k0 = seen_prefix[0][0][0]
+    student_k0 = out[0][0]
+    assert not torch.allclose(prefix_k0, student_k0, atol=1e-2)
+    # Prefix keys match un-rebased teacher keys from raw K at positions 50..61.
+    diffs = (prefix_k0[0, 0, :, None, :] - kv[0][0][0, 0, None, :, :]).abs().max(dim=-1).values.min(dim=-1).values
+    assert torch.allclose(diffs, torch.zeros_like(diffs), atol=1e-6)
+    # Returned student keys match re-rotated keys at positions 0..3.
+    raw_matched_idx = (prefix_k0[0, 0, :, None, :] - kv[0][0][0, 0, None, :, :]).abs().max(dim=-1).values.argmin(dim=-1)
+    expected_s0 = _apply_rope_single(model, raw_k[0, 0][raw_matched_idx], torch.arange(0, 4))
+    assert torch.allclose(student_k0[0, 0], expected_s0, atol=1e-5)
