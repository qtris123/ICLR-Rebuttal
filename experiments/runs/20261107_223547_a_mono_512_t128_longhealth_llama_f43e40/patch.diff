diff --git a/examples/shared/evaluate/run_accuracy.sh b/examples/shared/evaluate/run_accuracy.sh
index 04d24b9..39e6683 100644
--- a/examples/shared/evaluate/run_accuracy.sh
+++ b/examples/shared/evaluate/run_accuracy.sh
@@ -41,7 +41,7 @@ $PY examples/shared/evaluate/build_generation_matrix_plan.py \
   --phases 1 2 3 4 5 --batch-size 16 --max-new-tokens 64 --temperature 0.0 \
   --answer-prime ' Answer:'
 
-# Fan the five stages across the provided GPUs.
+# Fan the five stages across the provided GPUs, respecting single-GPU serial execution.
 IFS=',' read -r -a GPU_ARR <<< "$GPUS"
 NG=${#GPU_ARR[@]}
 pids=()
@@ -49,10 +49,17 @@ i=0
 for phase in 1 2 3 4 5; do
   sid=$(printf 'p%02d' "$phase")
   g=${GPU_ARR[$(( i % NG ))]}
-  CUDA_VISIBLE_DEVICES="$g" $PY examples/shared/evaluate/generation_accuracy_matrix.py \
-    --plan "$PLAN" --stages "$sid" \
-    > "logs/acc_${DS}_${TAG}_${sid}.log" 2>&1 &
-  pids+=($!)
+  if (( NG == 1 )); then
+    echo "Running accuracy eval for stage $sid on GPU $g..."
+    CUDA_VISIBLE_DEVICES="$g" $PY examples/shared/evaluate/generation_accuracy_matrix.py \
+      --plan "$PLAN" --stages "$sid" \
+      > "logs/acc_${DS}_${TAG}_${sid}.log" 2>&1
+  else
+    CUDA_VISIBLE_DEVICES="$g" $PY examples/shared/evaluate/generation_accuracy_matrix.py \
+      --plan "$PLAN" --stages "$sid" \
+      > "logs/acc_${DS}_${TAG}_${sid}.log" 2>&1 &
+    pids+=($!)
+  fi
   i=$(( i + 1 ))
 done
 for p in "${pids[@]}"; do wait "$p"; done
