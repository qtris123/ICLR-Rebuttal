+def _rope_reposition(keys, from_pos, to_pos, head_dim, rope_theta=500000.0):
+    """Rotate keys from prefill position `from_pos` to cartridge slot `to_pos`."""
+    device = keys.device
+    delta = (to_pos.to(torch.float32) - from_pos.to(torch.float32))
+    inv_freq = 1.0 / (rope_theta ** (torch.arange(0, head_dim, 2, device=device).float() / head_dim))
+    angle = delta[:, None] * inv_freq[None, :]
+    emb = torch.cat([angle, angle], dim=-1)
+    cos = emb.cos().to(keys.dtype)
+    sin = emb.sin().to(keys.dtype)
+    x1 = keys[..., : head_dim // 2]
+    x2 = keys[..., head_dim // 2 :]
+    rotated = torch.cat((-x2, x1), dim=-1)
+    return keys * cos + rotated * sin
+
+
